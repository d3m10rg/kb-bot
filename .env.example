# Получите токен у @BotFather. Настоящий .env не добавляйте в git.
BOT_TOKEN=

# Короткие имена стикерпаков (поле set_name), через запятую.
FORBIDDEN_STICKER_PACKS=KB_Telemost_by_fStikBot,RzhevkiQuotes_by_fStikBot

# Длительность мута после третьего нарушения.
MUTE_MINUTES=10

# Время на решение капчи в секундах.
CAPTCHA_TIMEOUT_SECONDS=60

# Поддерживаются настоящие многострочные значения внутри двойных кавычек.
WARNING_TEXT_1="Вы здесь не ради баллов, не ради получения зачёта и не ради проёба времени. Вы — гоночное ЖИВОТНОЕ, для которого запах бензина и резины - главный триггер в жизни. Вы сливаетесь со своим болидом в единое целое, в единый организм. Вы как пилот Евангелиона, чувствуете свою машину от кончиков пальцев, до жопы. Вы возможно танцуете последний танец с ним, идя на пределе его возможностей в сантиметрах от блоков. Разве стоят какие-то баллы этого ощущения и выброса адреналина?"

WARNING_TEXT_2="Ещё раз про баллы напишешь — в мут улетишь"

WARNING_TEXT_3="Пиздец ты тупой..."

# В Docker Compose этот путь переопределяется на /data/bot.sqlite3.
DATABASE_PATH=bot.sqlite3

